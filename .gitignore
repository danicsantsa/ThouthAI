# Secrets and local configuration
gui_settings.json
.env
.env.*

# Local runtime data
recorded_videos/
camera_preview.png
*.csv
*.mp4
*.mp4.part.mp4

# Python environments and caches
myenv/
tracking_env/
venv/
__pycache__/
*.py[cod]
.pytest_cache/

# Build output
dist/
build/atum/
build/*.toc
build/*.pyz
build/warn-*.txt
build/xref-*.html
*.spec.bak

# IDE and OS files
.vscode/
.idea/
.DS_Store

# Local logs and generated exports
*.log
*.tmp

# Unrelated personal/reference documents
20201222_5004-b00-010201_web.pdf

cat > .gitignore << 'EOF'
# Virtuelle Umgebungen
tracking_env/
myenv/

# Python Cache
__pycache__/
*.pyc

# Build-Artefakte
build/
dist/

# Generierte Daten/Logs
*.csv
recorded_videos/
camera_preview.png

# Konfiguration mit möglichen Zugangsdaten
db_config.json

# Modell-Dateien (ggf. groß, Git LFS verwenden)
*.task
*.tflite
EOF

git add .gitignore
git commit -m "Add .gitignore"
git push
